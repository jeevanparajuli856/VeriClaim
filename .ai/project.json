{
  "schema_version": "1.0",
  "status": "INCEPTION_READY",
  "components": {
    "backend": {
      "enabled": true,
      "path": "backend",
      "technology": "Python / FastAPI / Pydantic with Google Gen AI SDK for Vertex AI"
    },
    "frontend": {
      "enabled": true,
      "path": "frontend",
      "technology": "Node.js 24 LTS / React / strict TypeScript / Vite / npm"
    },
    "database": {
      "enabled": false,
      "provider": null,
      "migration_path": null
    }
  },
  "verification": {
    "checks": [
      {
        "name": "demo backend tests",
        "command": [
          "python3",
          "-m",
          "pytest",
          "-q",
          "tests/backend"
        ],
        "cwd": ".",
        "required": true
      },
      {
        "name": "frontend verification",
        "command": [
          "npm",
          "--prefix",
          "frontend",
          "run",
          "verify"
        ],
        "cwd": ".",
        "required": true
      }
    ]
  },
  "security": {
    "checks": [
      {
        "name": "hash-locked dependency audit",
        "command": [
          "python3",
          "-m",
          "pip_audit",
          "--strict",
          "--require-hashes",
          "--no-deps",
          "--disable-pip",
          "--progress-spinner",
          "off",
          "-r",
          "requirements.lock"
        ],
        "cwd": ".",
        "required": true
      },
      {
        "name": "frontend dependency audit",
        "command": [
          "npm",
          "--prefix",
          "frontend",
          "audit",
          "--audit-level=high"
        ],
        "cwd": ".",
        "required": true
      }
    ]
  }
}
