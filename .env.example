# Local-only example. Replace every placeholder in your uncommitted .env.
# Never commit runtime values or credentials, and do not source this file unchanged.

APP_ENV=<local-environment-name>
DATABASE_URL=<local-postgresql-connection-url>
API_BASE_URL=<local-backend-url>

# Vertex AI uses Google Cloud Application Default Credentials; no credential value belongs here.
export GOOGLE_CLOUD_PROJECT=<google-cloud-project-id>
export GOOGLE_CLOUD_LOCATION=<vertex-ai-region>
export GOOGLE_GENAI_USE_VERTEXAI=<true-or-false>
export VERTEX_GEMINI_MODEL=<approved-gemini-model-id>

# Bounded model/workflow limits.
export VERTEX_GEMINI_TIMEOUT_SECONDS=<approved-timeout-seconds>
export VERTEX_GEMINI_MAX_OUTPUT_TOKENS=<approved-max-output-tokens>
export AGENT_MAX_TOOL_CALLS=<approved-max-tool-calls>
export AGENT_MAX_TOTAL_SECONDS=<approved-max-workflow-seconds>
export AGENT_MAX_COST_USD=<approved-max-cost-usd>
