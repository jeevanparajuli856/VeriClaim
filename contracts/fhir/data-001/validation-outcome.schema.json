{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vericlaim.local/contracts/fhir/data-001/validation-outcome.schema.json",
  "title": "DATA-001 minimal FHIR R4 compatibility outcome",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "contract_version",
    "decision",
    "states",
    "declared_source_set_sha256",
    "observed_source_set_sha256",
    "boundary_sha256",
    "package_lock_sha256",
    "layers",
    "project_findings",
    "carin",
    "terminology"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "contract_id": {
      "const": "vericlaim-fhir-r4-minimal-compatibility"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "decision": {
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "states": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "minimal-profile-valid",
          "carin-no-errors-reported",
          "carin-nonconformant",
          "carin-diagnostic-unavailable",
          "terminology-unverified",
          "rejected"
        ]
      }
    },
    "declared_source_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "observed_source_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "boundary_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "package_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "enum": [
              "source",
              "json",
              "support",
              "required-fields",
              "references",
              "content-isolation"
            ]
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not-run"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "project_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "carin": {
      "type": "object",
      "required": [
        "status",
        "acceptance_authority",
        "tool",
        "package",
        "counts",
        "findings"
      ],
      "properties": {
        "status": {
          "enum": [
            "no-errors-reported",
            "nonconformant",
            "diagnostic-unavailable",
            "not-run-rejected"
          ]
        },
        "acceptance_authority": {
          "const": false
        },
        "tool": {
          "const": "HL7 FHIR Validator CLI#6.10.2"
        },
        "package": {
          "const": "hl7.fhir.us.carin-bb#2.2.0"
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "raw_evidence": {
          "type": "object",
          "required": [
            "sha256",
            "format",
            "trusted_content",
            "bytes",
            "issue_count"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "format": {
              "enum": [
                "FHIR-R4-Bundle-of-OperationOutcome",
                "FHIR-R4-OperationOutcome"
              ]
            },
            "trusted_content": {
              "const": false
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "issue_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/carinFinding"
          }
        },
        "verified_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/verifiedArtifact"
          }
        },
        "availability_error": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9 ._:/#()\\-]+$"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "nonconformant"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "counts": {
                "anyOf": [
                  {
                    "properties": {
                      "error": {
                        "minimum": 1
                      }
                    },
                    "required": [
                      "error"
                    ]
                  },
                  {
                    "properties": {
                      "fatal": {
                        "minimum": 1
                      }
                    },
                    "required": [
                      "fatal"
                    ]
                  }
                ]
              }
            },
            "required": [
              "raw_evidence",
              "verified_artifacts"
            ]
          }
        }
      ]
    },
    "terminology": {
      "type": "object",
      "required": [
        "status",
        "acceptance_authority",
        "membership_asserted",
        "opaque_values"
      ],
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "verified",
            "not-evaluated-rejected"
          ]
        },
        "acceptance_authority": {
          "const": false
        },
        "membership_asserted": {
          "const": false
        },
        "opaque_values": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_path",
              "json_pointer",
              "system"
            ],
            "properties": {
              "source_path": {
                "$ref": "#/$defs/sourcePath"
              },
              "json_pointer": {
                "$ref": "#/$defs/jsonPointer"
              },
              "system": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "code_present": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "accepted"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "layers": {
            "const": [
              {
                "name": "source",
                "status": "passed"
              },
              {
                "name": "json",
                "status": "passed"
              },
              {
                "name": "support",
                "status": "passed"
              },
              {
                "name": "required-fields",
                "status": "passed"
              },
              {
                "name": "references",
                "status": "passed"
              },
              {
                "name": "content-isolation",
                "status": "passed"
              }
            ]
          },
          "states": {
            "oneOf": [
              {
                "const": [
                  "minimal-profile-valid",
                  "carin-no-errors-reported"
                ]
              },
              {
                "const": [
                  "minimal-profile-valid",
                  "carin-no-errors-reported",
                  "terminology-unverified"
                ]
              },
              {
                "const": [
                  "minimal-profile-valid",
                  "carin-nonconformant"
                ]
              },
              {
                "const": [
                  "minimal-profile-valid",
                  "carin-nonconformant",
                  "terminology-unverified"
                ]
              },
              {
                "const": [
                  "minimal-profile-valid",
                  "carin-diagnostic-unavailable"
                ]
              },
              {
                "const": [
                  "minimal-profile-valid",
                  "carin-diagnostic-unavailable",
                  "terminology-unverified"
                ]
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "states": {
            "const": [
              "rejected"
            ]
          },
          "carin": {
            "properties": {
              "status": {
                "const": "not-run-rejected"
              },
              "counts": {
                "const": {
                  "fatal": 0,
                  "error": 0,
                  "warning": 0,
                  "information": 0
                }
              },
              "findings": {
                "maxItems": 0
              }
            }
          },
          "terminology": {
            "properties": {
              "status": {
                "const": "not-evaluated-rejected"
              },
              "opaque_values": {
                "maxItems": 0
              }
            }
          },
          "project_findings": {
            "minItems": 1
          },
          "layers": {
            "contains": {
              "type": "object",
              "properties": {
                "status": {
                  "const": "failed"
                }
              },
              "required": [
                "status"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "states": {
            "contains": {
              "const": "terminology-unverified"
            }
          }
        },
        "required": [
          "states"
        ]
      },
      "then": {
        "properties": {
          "terminology": {
            "properties": {
              "status": {
                "const": "unverified"
              },
              "opaque_values": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminology": {
            "properties": {
              "status": {
                "const": "unverified"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "terminology"
        ]
      },
      "then": {
        "properties": {
          "states": {
            "contains": {
              "const": "terminology-unverified"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "carin": {
            "properties": {
              "status": {
                "const": "no-errors-reported"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "carin"
        ]
      },
      "then": {
        "properties": {
          "states": {
            "contains": {
              "const": "carin-no-errors-reported"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "carin": {
            "properties": {
              "status": {
                "const": "nonconformant"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "carin"
        ]
      },
      "then": {
        "properties": {
          "states": {
            "contains": {
              "const": "carin-nonconformant"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "carin": {
            "properties": {
              "status": {
                "const": "diagnostic-unavailable"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "carin"
        ]
      },
      "then": {
        "properties": {
          "states": {
            "contains": {
              "const": "carin-diagnostic-unavailable"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourcePath": {
      "type": "string",
      "pattern": "^(dataset|tests/fixtures/fhir/data-001)/[A-Za-z0-9._/-]+$"
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^(/([^/~]|~[01])*)*$"
    },
    "counts": {
      "type": "object",
      "required": [
        "fatal",
        "error",
        "warning",
        "information"
      ],
      "properties": {
        "fatal": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "minimum": 0
        },
        "information": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "rule_id",
        "source",
        "severity",
        "machine_code",
        "message",
        "source_path",
        "json_pointer"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3}$"
        },
        "source": {
          "enum": [
            "project",
            "carin",
            "terminology"
          ]
        },
        "severity": {
          "enum": [
            "fatal",
            "error",
            "warning",
            "information"
          ]
        },
        "machine_code": {
          "type": "string",
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_path": {
          "$ref": "#/$defs/sourcePath"
        },
        "json_pointer": {
          "$ref": "#/$defs/jsonPointer"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "carinFinding": {
      "allOf": [
        {
          "$ref": "#/$defs/finding"
        },
        {
          "required": [
            "evidence_sha256"
          ]
        }
      ]
    },
    "verifiedArtifact": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "version",
        "sha256",
        "bytes"
      ],
      "properties": {
        "kind": {
          "enum": [
            "validator",
            "runtime",
            "package"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
