{
  "schema_version": "1.0",
  "task_id": "DATA-001",
  "contract_id": "vericlaim-fhir-r4-minimal-compatibility",
  "contract_version": "1.0.0",
  "status": "READY",
  "representation_family": "FHIR R4 JSON",
  "acceptance_authority": "project-minimal-compatibility-rules",
  "conformance_claims": {
    "base_fhir_r4": false,
    "carin_2_2_0": false,
    "note": "Acceptance means only that the project-owned minimal compatibility rules passed."
  },
  "source_set": {
    "manifest": "contracts/fhir/data-001/source-manifest.json",
    "accepted_classifications": [
      "approved-synthetic-local",
      "project-authored-synthetic"
    ],
    "required_roles": [
      "patient",
      "coverage-searchset",
      "pharmacy-eob-searchset",
      "provenance-readme"
    ],
    "implicit_discovery": false,
    "remote_fetch": false,
    "path_rules": {
      "repository_relative": true,
      "unique": true,
      "allow_absolute": false,
      "allow_traversal": false
    }
  },
  "json": {
    "encoding": "UTF-8",
    "top_level": "object",
    "reject_duplicate_keys": true,
    "allow_repair_or_coercion": false
  },
  "profile_markers": {
    "semantics": "routing-only; never a conformance claim",
    "Patient": [
      "http://hl7.org/fhir/us/carin-bb/StructureDefinition/C4BB-Patient",
      "http://hl7.org/fhir/us/carin-bb/StructureDefinition/C4BB-Patient|2.2.0"
    ],
    "Coverage": [
      "http://hl7.org/fhir/us/carin-bb/StructureDefinition/C4BB-Coverage",
      "http://hl7.org/fhir/us/carin-bb/StructureDefinition/C4BB-Coverage|2.2.0"
    ],
    "ExplanationOfBenefit": [
      "http://hl7.org/fhir/us/carin-bb/StructureDefinition/C4BB-ExplanationOfBenefit-Pharmacy",
      "http://hl7.org/fhir/us/carin-bb/StructureDefinition/C4BB-ExplanationOfBenefit-Pharmacy|2.2.0"
    ]
  },
  "resources": {
    "Patient": {
      "document_form": "standalone",
      "required_nonempty": [
        "/id",
        "/meta/profile",
        "/identifier",
        "/name"
      ],
      "allowed_top_level_fields": [
        "resourceType",
        "id",
        "meta",
        "extension",
        "identifier",
        "name",
        "gender",
        "birthDate",
        "deceasedDateTime",
        "address"
      ]
    },
    "Coverage": {
      "document_form": "homogeneous-searchset-entry",
      "required_nonempty": [
        "/id",
        "/meta/profile",
        "/status",
        "/type",
        "/beneficiary/reference"
      ],
      "allowed_top_level_fields": [
        "resourceType",
        "id",
        "meta",
        "extension",
        "status",
        "type",
        "subscriberId",
        "beneficiary",
        "relationship",
        "period",
        "payor",
        "class"
      ]
    },
    "ExplanationOfBenefit": {
      "document_form": "homogeneous-searchset-entry",
      "required_nonempty": [
        "/id",
        "/meta/profile",
        "/status",
        "/type",
        "/use",
        "/patient/reference",
        "/insurance",
        "/item"
      ],
      "required_each": {
        "/insurance": [
          "/coverage/reference"
        ]
      },
      "allowed_top_level_fields": [
        "resourceType",
        "id",
        "meta",
        "identifier",
        "status",
        "type",
        "use",
        "patient",
        "billablePeriod",
        "created",
        "insurer",
        "provider",
        "facility",
        "outcome",
        "careTeam",
        "supportingInfo",
        "insurance",
        "item",
        "payment"
      ]
    }
  },
  "bundle": {
    "resourceType": "Bundle",
    "type": "searchset",
    "required_nonempty": [
      "/id",
      "/entry"
    ],
    "allowed_top_level_fields": [
      "resourceType",
      "id",
      "meta",
      "type",
      "total",
      "link",
      "entry"
    ],
    "entry_allowed_fields": [
      "resource",
      "fullUrl",
      "search"
    ],
    "entry_fullUrl_required": false,
    "homogeneous_entries": true,
    "total": {
      "type": "non-negative-integer",
      "minimum": "entry-count",
      "equality_required": false
    },
    "rejected_types": [
      "batch",
      "transaction",
      "history",
      "document",
      "message",
      "collection"
    ],
    "rejected_entry_fields": [
      "request",
      "response"
    ]
  },
  "registries": {
    "algorithm": "Collect unique strings from every extension[].url or object.system in the four source-manifest files, sort Unicode code-point ascending, join with LF including a final LF, then SHA-256 the UTF-8 bytes.",
    "extension_uris": {
      "count": 159,
      "sha256": "c1e73cad69d313a4611d6b3d46ed68d1428994a7f07b664f76a771f37c203fb5",
      "policy": "exact source-set registry; any added or removed URI is rejected"
    },
    "system_uris": {
      "count": 173,
      "sha256": "919078b732f4f9209c5fb36d675723f093d21191c88a4611a9f4526ac55a1f8b",
      "policy": "exact source-set registry; values remain opaque and unverified"
    }
  },
  "preserve_opaque": {
    "scope": "All allowed non-anchor subtrees and non-modifier extensions from the exact source registry",
    "never_dereference": true,
    "never_execute": true,
    "never_render_as_active_content": true,
    "never_infer_display_or_domain_meaning": true
  },
  "rejected_content_keys_any_depth": [
    "modifierExtension",
    "contained",
    "text",
    "attachment",
    "request",
    "response"
  ],
  "rejected_content_patterns": [
    "base64Binary payloads",
    "absolute or remote required references",
    "fragment required references",
    "path-traversal source paths",
    "unregistered top-level resource fields",
    "unknown extension or system registry membership"
  ],
  "references": [
    {
      "source_type": "Coverage",
      "path": "/beneficiary/reference",
      "target_type": "Patient",
      "required": true
    },
    {
      "source_type": "ExplanationOfBenefit",
      "path": "/patient/reference",
      "target_type": "Patient",
      "required": true
    },
    {
      "source_type": "ExplanationOfBenefit",
      "path": "/insurance/*/coverage/reference",
      "target_type": "Coverage",
      "required": true
    }
  ],
  "reference_policy": {
    "format": "ResourceType/id",
    "same_source_set": true,
    "expected_type": true,
    "resolve_exactly_once": true,
    "allow_absolute": false,
    "allow_remote": false,
    "allow_fragment": false,
    "other_references": "preserve-opaque; never resolve"
  },
  "outcome": {
    "schema": "contracts/fhir/data-001/validation-outcome.schema.json",
    "accepted_decision": "accepted",
    "rejected_decision": "rejected",
    "canonical_state_order": [
      "minimal-profile-valid",
      "carin-no-errors-reported|carin-nonconformant|carin-diagnostic-unavailable",
      "terminology-unverified"
    ],
    "seed_expected_states": [
      "minimal-profile-valid",
      "carin-nonconformant",
      "terminology-unverified"
    ],
    "rejected_states": [
      "rejected"
    ],
    "carin_affects_decision": false,
    "terminology_affects_decision": false
  },
  "carin_diagnostic": {
    "package": "hl7.fhir.us.carin-bb#2.2.0",
    "validator": "HL7 FHIR Validator CLI#6.10.2",
    "network": false,
    "terminology_server": false,
    "acceptance_authority": false,
    "preserve_original_severity": true,
    "forbid_conformance_claim_on_errors": true,
    "unavailable_fails_task_verification": true
  },
  "terminology": {
    "default_status": "unverified",
    "preserve_system_and_code": true,
    "allow_substitution": false,
    "allow_live_lookup": false,
    "allow_membership_inference": false,
    "allowed_use": [
      "display-as-untrusted-source-data",
      "human-investigation"
    ],
    "prohibited_independent_conclusions": [
      "coverage",
      "payment",
      "coding",
      "fraud",
      "clinical",
      "policy"
    ]
  },
  "rule_ids": [
    "SOURCE-MANIFEST-001",
    "DATA-CLASS-001",
    "JSON-SYNTAX-001",
    "FHIR-COMPAT-ENVELOPE-001",
    "FHIR-COMPAT-RESOURCE-001",
    "FHIR-COMPAT-PROFILE-MARKER-001",
    "FHIR-COMPAT-REQUIRED-001",
    "FHIR-COMPAT-ID-001",
    "FHIR-COMPAT-REF-001",
    "FHIR-COMPAT-CONTENT-001",
    "CARIN-DIAGNOSTIC-001",
    "TERM-UNVERIFIED-001"
  ],
  "security_invariants": {
    "synthetic_only": true,
    "human_consequential_authority": true,
    "evidence_grounding_required_downstream": true,
    "no_invented_semantics": true,
    "no_production_access": true,
    "no_external_record_upload": true
  }
}
